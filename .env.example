# Kopieren nach .env und anpassen. .env gehoert nicht ins Git.

# --- Sprachmodell (jede OpenAI-kompatible Chat-API) ---
LLM_API_KEY=
# Standard ist OpenRouter. Fuer OpenAI direkt: https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter: anthropic/claude-sonnet-4  |  OpenAI direkt z. B.: gpt-4.1
LLM_MODELL=anthropic/claude-sonnet-4

# --- Abruf ---
# Kommagetrennte CheckMates-Bereich-IDs; leer = Liste aus config.toml
# Alle IDs: python3 checkmates.py bereiche
CMK_BEREICHE=
# Uhrzeit fuer den taeglichen Lauf im Dienstbetrieb (Container)
CMK_UHRZEIT=07:00
TZ=Europe/Berlin

# --- Pfade ---
# Ohne Container: wohin Datenbank, Zusammenfassungen und HTML geschrieben werden
# (leer = Projektordner) und wohin die fertigen Seiten zusaetzlich kopiert werden.
CMK_DATEN_DIR=
CMK_WEB_DIR=
# Mit Container: Ordner auf dem Host, die in die Container gemountet werden
CMK_DATEN_PFAD=./volumes/daten
CMK_WEB_PFAD=./volumes/web

# --- Nutzer ---
# Logins fuer die Webseite: name:passwort, mehrere mit Komma
WEB_USERS=
# Unter welcher UID/GID der App-Container laeuft (Eigentuemer der Volumes)
CMK_UID=1000
CMK_GID=1000
# Port, unter dem die Webseite auf dem Host erreichbar ist
CMK_WEB_PORT=8080
